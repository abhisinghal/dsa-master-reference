# Environment variables for DSA Master Reference
#
# Copy this file to `.env` and fill in only the services you use.
# Nothing here is required for a local build — every integration has a
# localStorage-only fallback and the site works without any env vars.
#
# Vue reads env vars via `import.meta.env.VITE_*` at build time. Any
# secret you commit here becomes public. Use only PUBLIC keys.

# --- Newsletter capture (EmailCapture.vue) ---
# Free tier: https://buttondown.email/ (500 subscribers free)
# The Buttondown embed key is safe to expose (write-only signup form).
VITE_BUTTONDOWN_EMBED_KEY=

# --- AI Companion (AiCompanion.vue) ---
# When set, AiCompanion calls this endpoint instead of using the
# template-response fallback. Endpoint must be a serverless proxy you
# control that forwards to OpenAI/Anthropic (never expose the real key).
VITE_AI_COMPANION_ENDPOINT=

# --- Analytics (Plausible.io or Umami) ---
# Domain configured in your analytics dashboard. Empty = no tracking.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT_URL=

# --- Cross-device sync (future) ---
# When Supabase Auth is wired up, these enable optional cloud sync
# of solved-status, bookmarks, streaks, and study progress.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Support links (SupportPanel.vue) ---
# GitHub Sponsors + Buy Me a Coffee URLs. Empty = panel hidden.
VITE_SPONSOR_URL=https://github.com/sponsors/absinghal-microsoft
VITE_COFFEE_URL=https://www.buymeacoffee.com/absinghal
